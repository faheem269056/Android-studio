<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp"
            android:background="@drawable/bg_header">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOURPLANNER"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Plan your next escape"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Build a simple itinerary in a few taps."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SectionLabel"
                android:text="TRIP DETAILS" />

            <EditText
                android:id="@+id/etTravellerName"
                style="@style/PlannerInput"
                android:hint="Traveller name"
                android:inputType="textPersonName"
                android:drawableStart="@drawable/ic_person" />

            <EditText
                android:id="@+id/etDestination"
                style="@style/PlannerInput"
                android:layout_marginTop="12dp"
                android:hint="Destination"
                android:inputType="textCapWords"
                android:drawableStart="@drawable/ic_location" />

            <EditText
                android:id="@+id/etDays"
                style="@style/PlannerInput"
                android:layout_marginTop="12dp"
                android:hint="Number of days"
                android:inputType="number"
                android:drawableStart="@drawable/ic_calendar" />

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="26dp"
                android:text="CHOOSE YOUR EXPERIENCE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnAdventure"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Adventure"
                    android:onClick="onAdventureClicked" />

                <Button
                    android:id="@+id/btnHeritage"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="Heritage"
                    android:onClick="onHeritageClicked" />

                <Button
                    android:id="@+id/btnRelaxation"
                    style="@style/CategoryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="Relaxation"
                    android:onClick="onRelaxationClicked" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/destinationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
